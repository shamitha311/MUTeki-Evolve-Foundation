# MUTeki-Evolve — environment configuration
#
# Copy to `.env` (git-ignored) and fill in the values you need.
# Variables already exported in your shell always win over this file.
#
# SECURITY: never commit a real `.env`. `.gitignore` blocks `.env` / `.env.*`.
# This `.env.example` carries placeholders only — no real secrets.

# ── Adapter mode ──────────────────────────────────────────────────────────────
# "mock_bridge" (default) — uses Muteki's own mock solver pipeline (EventBus +
#   SessionStore) with no LLM or Docker dependency. All tests use this.
# "real" — drives a live Muteki swarm with the Grok CLI + your XAI_API_KEY.
#   Requires: grok CLI on PATH + XAI_API_KEY set below.
MUTEKI_MODE=mock_bridge

# ── xAI / Grok API key (required for real mode) ───────────────────────────────
# Your xAI API key from https://console.x.ai
# The Grok CLI reads XAI_API_KEY from the environment automatically.
# No `grok login` or subscription required — API key is all you need.
XAI_API_KEY=xai-your-key-here

# ── Worker engine ─────────────────────────────────────────────────────────────
# Default: "grok" — uses XAI_API_KEY, no Pro subscription needed.
#
# Source-verified valid values and their required credentials:
#   "grok"      — xAI Grok CLI          → XAI_API_KEY              (API key)
#   "kimi"      — Kimi Code CLI          → API_KEY                  (API key)
#   "opencode"  — OpenCode CLI           → OPENAI_API_KEY           (API key)
#   "dsh"       — DeepSeek Harness       → API_KEY                  (API key)
#   "cursor"    — Cursor agent           → CURSOR_API_KEY           (API key)
#   "claude"    — Anthropic Claude CLI   → requires `claude login`  (subscription)
#   "codex"     — OpenAI Codex CLI       → requires `codex login`   (subscription)
#   "pi"        — Pi CLI                 → requires `pi` login       (subscription)
#   "omp"       — OMP CLI                → requires `omp` login      (subscription)
MUTEKI_WORKER_ENGINE=grok

# ── Worker model ──────────────────────────────────────────────────────────────
# Model override for the worker profile's "model" field.
# Leave EMPTY (default) — the Grok CLI picks the model from your account.
# To force a specific model, set e.g.:
#   MUTEKI_WORKER_MODEL=grok-3
#   MUTEKI_WORKER_MODEL=grok-3-mini
MUTEKI_WORKER_MODEL=

# ── Worker backend ────────────────────────────────────────────────────────────
# "local"     (default) — worker runs as a host subprocess.
#             Requires the engine CLI (e.g. `grok`) to be on PATH.
# "container" — worker runs inside Docker (requires Docker + worker image).
MUTEKI_WORKER_BACKEND=local

# ── Muteki web backend (optional, HTTP mode only) ─────────────────────────────
# Base URL of a running Muteki web API server (./run.sh web).
# Leave commented out to use in-process mode (build_driver() directly).
# MUTEKI_BACKEND=http://127.0.0.1:8000

# ── Timeouts ──────────────────────────────────────────────────────────────────
# Maximum seconds to wait for a run to finish (RUN_FINISHED event).
MUTEKI_TIMEOUT_SECONDS=300

# Maximum seconds to wait between events before treating the stream as stalled.
MUTEKI_EVENT_TIMEOUT_SECONDS=30

# ── Paths ─────────────────────────────────────────────────────────────────────
# Directory where Muteki's RunManager stores session JSONL files.
MUTEKI_SESSIONS_ROOT=sessions

# ── Scratch / dev server ──────────────────────────────────────────────────────
# Port for the scratch SSE mock server (scratch/server.py).
SCRATCH_PORT=8080
